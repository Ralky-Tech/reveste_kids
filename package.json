{
  "name": "reveste-kids-fullstack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n BACK,FRONT -c green,blue \"npm run dev:back\" \"npm run dev:front\"",
    "dev:back": "npm --prefix backend run dev",
    "dev:front": "npm --prefix frontend run dev",
    "compose": "docker compose",
    "compose:up": "docker compose up -d --build",
    "compose:logs": "docker compose logs -f --tail=100",
    "compose:down": "docker compose down",
    "compose:config": "docker compose config --quiet"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "socket.io": "^4.8.3"
  }
}
