# Copy to .env at the repository root and configure locally. Never commit .env.
# Runtime-only credentials; use an authorized database/credential for your team.
MONGODB_URI=
JWTSECRET=

# Public web OAuth client ID; used by both backend and frontend build.
GOOGLE_CLIENT_ID=

FRONTEND_PORT=8080
BACKEND_PORT=4001
# Optional explicit browser origin when accessing via a different hostname.
# FRONTEND_ORIGIN=http://localhost:8080

# Optional DNS IP, scoped to the container's Node process. Empty uses Docker DNS.
DOCKER_DNS_SERVER=

# Optional SMTP settings. Like/match/chat behavior does not depend on email delivery.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
