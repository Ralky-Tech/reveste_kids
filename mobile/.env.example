# Copie este arquivo para .env e preencha com os dados do ambiente que vai usar.
# O arquivo .env NÃO deve ir para o GitHub (já está no .gitignore).
# Depois de alterar o .env, reinicie o Expo (Ctrl + C e npx expo start).

# Endereço do backend, sem barra no final.
# Para desenvolvimento, use o backend rodando no seu computador pelo IP da rede Wi-Fi
# (ex.: http://192.168.0.15:4000). "localhost" não funciona no celular.
EXPO_PUBLIC_API_URL=

# Cloudinary usado para as fotos das peças.
# Para testes, use uma conta/preset de desenvolvimento, não o de produção.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
